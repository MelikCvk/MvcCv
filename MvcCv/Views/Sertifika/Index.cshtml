@using MvcCv.Models.Entity
@model IPagedList<MvcCv.Models.Entity.TblSertifikalarim>
@using PagedList
@using PagedList.Mvc
@{
    ViewBag.Title = "Sertifikalarım";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title" style="font-size: 22px; font-weight: 600; color: #333;">Sertifika Listesi</h4>
                    </div>
                    <div class="card-body">
                        <div class="timeline timeline-inverse">
                            @foreach (var x in Model)
                            {
                                <div class="time-label">
                                    <span class="bg-success">@x.Tarih</span>
                                </div>
                                <div>
                                    <i class="fas fa-medal bg-warning"></i>
                                    <div class="timeline-item">
                                        <div class="timeline-body">
                                            @x.Aciklama
                                            @if (!string.IsNullOrEmpty(x.Görsel))
                                            {
                                                <br />
                                                <a href="@x.Görsel" target="_blank">
                                                    <img src="@x.Görsel" alt="Sertifika Görseli"
                                                         style="width:80px; height:60px; object-fit:cover; margin-top:10px; border-radius:5px;" />
                                                </a>
                                            }
                                        </div>
                                        <div class="timeline-footer">
                                            <a class="btn btn-info btn-sm" href="/Sertifika/SertifikaGetir/@x.ID">
                                                <i class="fas fa-edit"></i> Düzenle
                                            </a>
                                            <a class="btn btn-danger btn-sm" href="/Sertifika/SertifikaSil/@x.ID"
                                               onclick="silOnay(event, this); return false;">
                                                <i class="fas fa-trash"></i> Sil
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="pagination-wrapper mt-3">
                            @Html.PagedListPager(Model,
                                page => Url.Action("Index", new { page }),
                                new PagedList.Mvc.PagedListRenderOptions
                                {
                                    DisplayLinkToIndividualPages = true,
                                    DisplayPageCountAndCurrentLocation = false,
                                    UlElementClasses = new[] { "pagination" },
                                    LiElementClasses = new[] { "page-item" },
                                })
                        </div>

                        <div class="mt-3">
                            <a href="/Sertifika/SertifikaEkle" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Yeni Sertifika Ekle
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>