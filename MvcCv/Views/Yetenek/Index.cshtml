@using MvcCv.Models.Entity
@model List<TblYeteneklerim>
@{
    ViewBag.Title = "Yetenek Listesi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@{ string renk = ""; }

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title" style="font-size: 22px; font-weight: 600; color: #333;">Yetenek Listesi</h4>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 10px;">ID</th>
                            <th>Yetenek</th>
                            <th>Derece</th>
                            <th style="width: 40px">Oran</th>
                            <th class="text-center">Düzenle</th>
                            <th class="text-center">Sil</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in Model)
                        {
                            if (x.Oran >= 0 && x.Oran <= 50)
                            {
                                renk = "progress-bar bg-danger";
                            }
                            else if (x.Oran >= 51 && x.Oran <= 70)
                            {
                                renk = "progress-bar bg-warning";
                            }
                            else if (x.Oran >= 71 && x.Oran <= 84)
                            {
                                renk = "progress-bar bg-primary";
                            }
                            else if (x.Oran >= 85 && x.Oran <= 100)
                            {
                                renk = "progress-bar bg-success";
                            }
                            <tr>
                                <td style="background-color: #f8f9fa; color: #000;">@x.ID</td>
                                <td>@x.Yetenek</td>
                                <td>
                                    <div class="progress progress-xs">
                                        <div class="@renk" style="width: @x.Oran%"></div>
                                    </div>
                                </td>
                                <td><span class="@renk">@x.Oran%</span></td>
                                <td class="text-center">
                                    <a class="btn btn-info btn-sm" href="/Yetenek/YetenekGetir/@x.ID">
                                        <i class="fas fa-pencil-alt"></i> Düzenle
                                    </a>
                                </td>
                                <td class="text-center">
                                    <a class="btn btn-danger btn-sm" href="/Yetenek/YetenekSil/@x.ID"
                                       onclick="silOnay(event, this); return false;">
                                        <i class="fas fa-trash"></i> Sil
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <br />
                <a href="/Yetenek/YeniYetenek" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Yeni Yetenek Ekle
                </a>
            </div>
        </div>
    </div>
</section>