@{
    ViewBag.Title = "AdminEkle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h4>Yeni Admin Ekleme Sayfası</h4>
<br />

<form class="form-group" method="post">
    <input type="text" name="KullaniciAdi" class="form-control" placeholder="Kullanıcı Adını Yazınız..." required minlength="5"
           maxlength="50" />
    <div class="invalid-feedback">Bu alan zorunludur.</div>
    <br />
    <input type="text" name="Sifre" class="form-control" placeholder="Şifreyi Yazınız..." required minlength="8"
           maxlength="50" />
    <div class="invalid-feedback">Bu alan zorunludur.</div>
    <br />

    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Kaydet</button>
    <button type="button" class="btn btn-secondary" onclick="history.back()">← İptal</button>
</form>


