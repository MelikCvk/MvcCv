@using MvcCv.Models.Entity
@model IEnumerable<TblDeneyimlerim>

<div class="resume-section-content">
    <h2 class="mb-5">Deneyimlerim</h2>
    @foreach (var x in Model)
    {
        <div class="d-flex flex-column flex-md-row justify-content-between mb-5">
            <div class="flex-grow-1">
                <h3 class="mb-0">@x.Baslik</h3>
                <div class="subheading mb-3">@x.AltBaslik</div>
                <ul>
                    @if (x.Aciklama != null)
                    {
                        foreach (var madde in x.Aciklama.Split('|'))
                        {
                            <li class="mb-1">@madde.Trim()</li>
                        }
                    }
                </ul>
            </div>
            <div class="flex-shrink-0"><span class="text-primary">@x.Tarih</span></div>
        </div>
    }
</div>