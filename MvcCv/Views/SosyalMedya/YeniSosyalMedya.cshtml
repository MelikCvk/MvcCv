@model MvcCv.Models.Entity.TblSosyalMedya
@{
    ViewBag.Title = "YeniSosyalMedya";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<br />
<h4>Yeni Hesap Ekleme Sayfası</h4>
<br />

<form method="post" id="yetenekForm">

    @Html.HiddenFor(x => x.ID)

    <div class="form-group">
        @Html.Label("Hesap Adı")
        @Html.TextBoxFor(x => x.Ad, new { @class = "form-control", placeholder = "Örn: LinkedIn, GitHub, Twitter...", required = "required", minlength = "1", maxlength = "30" })
        <div class="invalid-feedback">Bu alan zorunludur.</div>
    </div>
    <br />

    <div class="form-group">
        @Html.Label("Link")
        @Html.TextBoxFor(x => x.Link, new { @class = "form-control", placeholder = "Örn:\thttps://github.com/Me...", required = "required", minlength = "1", maxlength = "50" })
        <div class="invalid-feedback">Bu alan zorunludur.</div>
    </div>
    <br />

    <div class="form-group">
        @Html.Label("İkon")
        @Html.TextBoxFor(x => x.ikon, new { @class = "form-control", placeholder = "Örn: fa-facebook, fa-twitter...", required = "required", minlength = "1", maxlength = "30" })
        <div class="invalid-feedback">Bu alan zorunludur.</div>
    </div>
    <br />

    <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Kaydet</button>
    <button type="button" class="btn btn-secondary" onclick="history.back()">← İptal</button>
</form>