@using MvcCv.Models.Entity
@model List<TblSosyalMedya>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@{ string renk = ""; }

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Sosyal Medya Listem</h4>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 10px;">ID</th>
                            <th>Ad</th>
                            <th>Link</th>
                            <th>İkon</th>
                            <th class="text-center">Düzenle</th>
                            <th class="text-center">Sil</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td style="background-color: #f8f9fa; color: #000;">@x.ID</td>
                                <td>@x.Ad</td>
                                <td>@x.Link</td>
                                <td>@x.ikon</td>
                                <td class="text-center">
                                    <a class="btn btn-info btn-sm" href="/SosyalMedya/SosyalMedyaGetir/@x.ID">
                                        <i class="fas fa-pencil-alt"></i> Düzenle
                                    </a>
                                </td>
                                <td class="text-center">
                                    <a class="btn btn-danger btn-sm" href="/SosyalMedya/SosyalMedyaSil/@x.ID"
                                       onclick="silOnay(event, this); return false;">
                                        <i class="fas fa-trash"></i> Sil
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <br />
                <a href="/SosyalMedya/YeniSosyalMedya" class="btn btn-primary"><i class="fas fa-plus"></i> Yeni Hesap Ekle </a>
            </div>
        </div>
    </div>
</section>