@using PagedList
@using PagedList.Mvc
@model IPagedList<MvcCv.Models.Entity.Tbliletisim>
@{
    ViewBag.Title = "İletişim Mesajları";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@{
    var renkler = new[] { "bg-primary", "bg-danger", "bg-warning", "bg-info", "bg-dark", "bg-purple" };
    var random = new Random();
}
<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title" style="font-size: 22px; font-weight: 600; color: #333;">İletişim Mesajları</h4>
            </div>
            <div class="card-body">
                <div class="timeline timeline-inverse">
                    @foreach (var x in Model)
                    {
                        var renk = renkler[random.Next(renkler.Length)];
                        <div class="time-label">
                            <span class="@renk">@(x.Tarih.HasValue ? x.Tarih.Value.ToString("dd.MM.yyyy") : "-")</span>
                        </div>

                        <div>
                            <i class="fas fa-comments bg-warning"></i>
                            <div class="timeline-item">
                                <span class="time">
                                    <i class="far fa-clock"></i>
                                    @{
                                        var fark = DateTime.Now - (x.Tarih ?? DateTime.Now);
                                        string zamanFarki;
                                        if (fark.TotalMinutes < 1) { zamanFarki = "Az önce"; }
                                        else if (fark.TotalMinutes < 60) { zamanFarki = (int)fark.TotalMinutes + " dakika önce"; }
                                        else if (fark.TotalHours < 24) { zamanFarki = (int)fark.TotalHours + " saat önce"; }
                                        else if (fark.TotalDays < 30) { zamanFarki = (int)fark.TotalDays + " gün önce"; }
                                        else if (fark.TotalDays < 365) { zamanFarki = (int)(fark.TotalDays / 30) + " ay önce"; }
                                        else { zamanFarki = (int)(fark.TotalDays / 365) + " yıl önce"; }
                                    }
                                    @zamanFarki
                                </span>

                                <h3 class="timeline-header"><a href="#">@x.AdSoyad</a> — @x.Konu</h3>

                                <div class="timeline-body">
                                    @x.Mesaj
                                </div>

                                <div class="timeline-footer">
                                    <span class="text-muted"><i class="fas fa-envelope"></i> @x.Mail</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="pagination-wrapper mt-4 d-flex justify-content-center">
                    @Html.PagedListPager(Model,
                                                      page => Url.Action("Index", new { page }),
                                                      new PagedList.Mvc.PagedListRenderOptions
                                                      {
                                                          DisplayLinkToIndividualPages = true,
                                                          DisplayPageCountAndCurrentLocation = false,
                                                          UlElementClasses = new[] { "pagination m-0" },
                                                          LiElementClasses = new[] { "page-item" }
                                                      })
                </div>

            </div>
        </div>
    </div>
</section>
